{
  "name": "knitscape",
  "version": "1.0.0",
  "main": "index.js",
  "author": "branchwelder",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "host": "vite --host",
    "build": "vite build",
    "generate:code-guide-lines": "node scripts/generate-code-guide-lines.mjs",
    "validate:single-only": "node scripts/validate-single-only.mjs",
    "validate:code-guide": "node scripts/validate-code-guide.mjs",
    "validate:intranet": "node scripts/validate-intranet-build.mjs",
    "validate:single-ui": "node scripts/validate-single-face-ui-labels.mjs",
    "validate:i18n": "node scripts/validate-language-switching.mjs",
    "validate:pattern-dimensions": "node scripts/validate-pattern-dimension-sync.mjs",
    "validate:dimension-input-focus": "node scripts/validate-dimension-input-focus.mjs",
    "validate:two-ply-yarn": "node scripts/validate-two-ply-yarn.mjs",
    "validate:sim-wheel-performance": "node scripts/validate-simulation-wheel-performance.mjs",
    "validate:no-yarn-length-simulation": "node scripts/validate-no-yarn-length-simulation.mjs",
    "validate:row-length-loop-model": "node --experimental-default-type=module scripts/validate-row-length-loop-model.mjs",
    "validate:yarn-length-gauge": "node --experimental-default-type=module scripts/validate-yarn-length-gauge.mjs",
    "validate:yarn-length-parameters": "node scripts/validate-yarn-length-parameters.mjs",
    "validate:yarn-sequence-editor": "node --experimental-default-type=module scripts/validate-yarn-sequence-editor.mjs",
    "validate:central-stitch-toolbar": "node scripts/validate-central-stitch-toolbar.mjs",
    "validate:needle-arrangement-transform": "node --experimental-default-type=module scripts/validate-needle-arrangement-transform.mjs",
    "validate:pattern-unit-derivation": "node --experimental-default-type=module scripts/validate-pattern-unit-derivation.mjs",
    "validate:pattern-file-v3": "node --experimental-default-type=module scripts/validate-pattern-file-v3.mjs",
    "validate:needle-arrangement-state": "node scripts/validate-needle-arrangement-state.mjs",
    "validate:dual-pattern-editor": "node scripts/validate-dual-pattern-editor.mjs",
    "validate:bitmap-pointer-unit-boundary": "node scripts/validate-bitmap-pointer-unit-boundary.mjs",
    "validate:needle-arrangement-acceptance": "node scripts/validate-needle-arrangement-acceptance.mjs",
    "validate:path-uv-yarn-texture": "node --experimental-default-type=module scripts/validate-path-uv-yarn-texture.mjs",
    "validate:event-driven-render": "node --experimental-default-type=module scripts/validate-event-driven-render.mjs",
    "validate:texture-cache-lifecycle": "node scripts/validate-texture-cache-lifecycle.mjs",
    "validate:yarn-simulation-characterization": "node scripts/validate-yarn-simulation-characterization.mjs",
    "validate:yarn-simulation-modules": "node scripts/validate-yarn-simulation-modules.mjs",
    "validate:left-sidebar-modules": "node scripts/validate-left-sidebar-modules.mjs",
    "preview": "vite build && vite preview",
    "deploy": "vite build && echo knitscape.net > ./dist/CNAME && gh-pages -d dist"
  },
  "dependencies": {
    "@eastdesire/jscolor": "^2.5.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "d3": "^7.8.5",
    "lit-html": "^2.7.5",
    "split.js": "^1.6.5",
    "vite": "^4.4.7"
  },
  "devDependencies": {
    "gh-pages": "^5.0.0",
    "jsdom": "^26.0.0"
  }
}
