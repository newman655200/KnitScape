+      check(changed.inputs[0].value === "27" && changed.rows[0].target === "27.0000" &&
+        changed.rows[0].status === "CONVERGED" && Math.abs(Number(changed.rows[0].solved) - 27) <= 0.00079375,
+        "E: valid 27 must commit and converge");
